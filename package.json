{
  "name": "markserv",
  "version": "1.20.0",
  "description": "🏁  serve markdown as html (GitHub style), index directories, live-reload as you edit",
  "preferGlobal": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "test": "xo && ava"
  },
  "keywords": [
    "code",
    "directory",
    "gfm",
    "github",
    "github flavored markdown",
    "highlighting",
    "html",
    "include",
    "index",
    "indexes",
    "links",
    "live",
    "live-reload",
    "livereload",
    "markdown",
    "markdown-it",
    "marked",
    "markitdown",
    "md",
    "realtime",
    "reload",
    "server",
    "syntax highlighting",
    "template",
    "templating"
  ],
  "bin": {
    "markserv": "lib/cli.js",
    "readme": "lib/readme.js"
  },
  "files": [
    "lib/cli.js",
    "lib/cli-defs.js",
    "lib/cli-help.txt",
    "lib/readme.js",
    "lib/server.js",
    "lib/splash.js",
    "lib/icons",
    "lib/templates/directory.html",
    "lib/templates/markdown.html",
    "lib/templates/error.html",
    "lib/templates/github.less",
    "lib/templates/highlight-js-github-gist.css",
    "lib/templates/markserv.css",
    "lib/templates/github-markdown-dark.css",
    "lib/templates/github-markdown-light.css",
    "lib/templates/github-markdown-synthwave.css",
    "media/markserv-favicon-96x96.png",
    "media/markserv-logo-term.png"
  ],
  "author": "Alistair MacDonald <al@pwn.io>",
  "email": "al@pwn.io",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://github.com/markserv/markserv.git"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "connect": "^3.7.0",
    "deepmerge": "^4.2.2",
    "emoji-regex": "^8.0.0",
    "get-port": "^5.1.0",
    "handlebars": "^4.5.3",
    "less": "^3.10.3",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^5.2.5",
    "markdown-it-emoji": "^1.4.0",
    "markdown-it-highlightjs": "^3.0.0",
    "markdown-it-include": "^2.0.0",
    "markdown-it-mathjax": "^2.0.0",
    "markdown-it-table-of-contents": "^0.4.4",
    "markdown-it-task-lists": "^2.1.1",
    "meow": "^13.0.0",
    "open": "^10.1.0",
    "send": "^0.18.0",
    "term-img": "^4.1.0",
    "ws": "^8.17.1"
  },
  "devDependencies": {
    "all-contributors-cli": "^6.11.2",
    "ava": "^4.0.0",
    "axios": "^1.16.1",
    "eslint": "^10.3.0",
    "eslint-config-xo": "^0.51.0",
    "eslint-plugin-n": "^18.0.1",
    "husky": "^8.0.0",
    "xo": "^2.0.2"
  },
  "ava": {
    "failfast": true,
    "serial": true
  }
}
